# Политика ${name} — сгенерирована Terraform (terraform-module-vault).
%{ if mounts_note != "" ~}
# Маунты: ${mounts_note}.
%{ endif ~}
# Правки через UI/CLI будут затёрты следующим apply.
%{ for r in rules ~}

%{ if r.note != "" ~}
# ${r.note}
%{ endif ~}
path "${r.path}" {
  capabilities = [${join(", ", formatlist("%q", r.capabilities))}]
}
%{ endfor ~}
%{ if extra_rules != "" ~}

# extra_rules
${extra_rules}
%{ endif ~}
