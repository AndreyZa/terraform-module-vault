.terraform/
*.tfstate
*.tfstate.*
crash.log

# Модуль не применяется напрямую, но в examples/ можно нечаянно оставить своё.
terraform.tfvars
*.auto.tfvars

# Примеры — образцы вызова, а не прод-конфиг, и лок им ни к чему. Закоммиченный
# лок дополнительно вреден: terraform init записывает хеш только под текущую
# платформу, и на любой другой init падает на несоответствии контрольных сумм.
.terraform.lock.hcl
